{
  "redirects": [
    {
      "source": "/tools/black-cat-airbnb-profit-tracker-spreadsheet.html",
      "destination": "/tools/airbnb-profit-tracker-spreadsheet.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
